(kicad_pcb
  (version 20240108)
  (generator "gigaspark_os")
  (general
    (thickness 1.6)
  )
  (paper "A3")
  (title_block
    (title "Gigaspark Mega")
    (date "2026-09-08")
    (rev "1.0")
    (comment 1 "Dual-core RTOS Handheld Device")
    (comment 2 "4-layer PCB: F.Cu / In1.Cu / In2.Cu / B.Cu")
  )
  (layers
    (0 "F.Cu" signal)
    (31 "In1.Cu" signal)
    (32 "In2.Cu" signal)
    (32 "B.Cu" signal)
    (33 "B.Adhes" user "B.Adhesive")
    (34 "F.Adhes" user "F.Adhesive")
    (35 "B.Paste" user)
    (36 "F.Paste" user)
    (37 "B.SilkS" user "B.Silkscreen")
    (38 "F.SilkS" user "F.Silkscreen")
    (39 "B.Mask" user "B.Mask")
    (40 "F.Mask" user "F.Mask")
    (41 "Dwgs.User" user "User.Drawings")
    (42 "Cmts.User" user "User.Comments")
    (43 "Eco1.User" user "User.Eco1")
    (44 "Eco2.User" user "User.Eco2")
    (45 "Edge.Cuts" user)
    (46 "Margin" user)
    (47 "B.CrtYd" user "B.Courtyard")
    (48 "F.CrtYd" user "F.Courtyard")
    (49 "B.Fab" user "B.Fabrication")
    (50 "F.Fab" user "F.Fabrication")
  )
  (setup
    (pad_to_mask_clearance 0.05)
    (allow_soldermask_bridges_in_footprints no)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions no)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (dashed_line_dash_ratio 12.000000)
      (dashed_line_gap_ratio 3.000000)
      (svgprecision 4)
      (plotframeref no)
      (viasonmask no)
      (mode 1)
      (useauxorigin no)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (outputformat 1)
      (mirror no)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "")
    )
  )
  (net 0 "")
  (net_class "Default" ""
    (clearance 0.2)
    (trace_width 0.25)
    (via_dia 0.6)
    (via_drill 0.3)
    (uvia_dia 0.3)
    (uvia_drill 0.1)
  )
  (net_class "Power" ""
    (clearance 0.3)
    (trace_width 2.0)
    (via_dia 0.8)
    (via_drill 0.4)
    (uvia_dia 0.3)
    (uvia_drill 0.1)
    (add_net "+3.3V")
    (add_net "+5V")
    (add_net "+12V")
    (add_net "+24V")
    (add_net "GND")
    (add_net "+36V_IN")
  )
  (net_class "HighCurrent" ""
    (clearance 0.4)
    (trace_width 2.5)
    (via_dia 1.2)
    (via_drill 0.6)
    (uvia_dia 0.3)
    (uvia_drill 0.1)
    (add_net "+24V_OUT")
    (add_net "+30V_OUT")
    (add_net "PSU_GND")
  )
  (net_class "RF" ""
    (clearance 0.3)
    (trace_width 0.25)
    (via_dia 0.6)
    (via_drill 0.3)
    (uvia_dia 0.3)
    (uvia_drill 0.1)
    (add_net "RF_433MHZ")
    (add_NET "NFC_SDA")
    (add_net "NFC_SCL")
  )

  # Board outline: 100mm x 80mm (edges on Edge.Cuts layer)
  (gr_rect (start 0 0) (end 100 80)
    (stroke (width 0.15) (type solid))
    (fill none)
    (layer "Edge.Cuts")
  )

  # Dimension labels
  (gr_text "GIGASPARK MEGA v1.0" (at 50 40) (layer "F.SilkS")
    (effects (font (size 2 2) (thickness 0.3)) (justify center))
  )
  (gr_text "100mm x 80mm  4-Layer" (at 50 44) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2)) (justify center))
  )

  # Mounting holes (M3, 3.2mm) in 4 corners
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu")
    (at 5 5)
    (property "Reference" "H1" (at 5 5) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (pad "1" thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu")
    (at 95 5)
    (property "Reference" "H2" (at 95 5) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (pad "1" thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu")
    (at 5 75)
    (property "Reference" "H3" (at 5 75) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (pad "1" thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu")
    (at 95 75)
    (property "Reference" "H4" (at 95 75) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (pad "1" thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask"))
  )
)
